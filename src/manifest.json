{
  "manifest_version": 3,
  "name": "Fit the Queue: YouTube playlist time & sort",
  "short_name": "Fit the Queue",
  "version": "2.0.0",
  "description": "Total and remaining YouTube playlist time at 1x-2x. Sort, filter, fill your minutes, export, and split courses across days. Private.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none';"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/lens.js", "selectors.js", "content.js"],
      "css": ["design.css", "content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fit the Queue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
